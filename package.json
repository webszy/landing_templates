{
  "name": "templates-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Independent static website templates managed with npm Workspaces.",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:aster": "npm run dev --workspace=@templates/aster",
    "dev:blackplus": "npm run dev --workspace=@templates/blackplus",
    "dev:crema": "npm run dev --workspace=@templates/crema",
    "dev:fieldhand": "npm run dev --workspace=@templates/fieldhand",
    "dev:forge": "npm run dev --workspace=@templates/forge",
    "dev:kerning": "npm run dev --workspace=@templates/kerning",
    "dev:liquid-type": "npm run dev --workspace=@templates/liquid-type",
    "dev:manila": "npm run dev --workspace=@templates/manila",
    "dev:membrane": "npm run dev --workspace=@templates/membrane",
    "dev:onda": "npm run dev --workspace=@templates/onda",
    "dev:peelmark": "npm run dev --workspace=@templates/peelmark",
    "dev:peelmark": "npm run dev --workspace=@templates/peelmark",
    "dev:pixnava": "npm run dev --workspace=@templates/pixnava",
    "dev:sandiego": "npm run dev --workspace=@templates/sandiego",
    "dev:revolver": "npm run dev --workspace=@templates/revolver",
    "build": "npm run build --workspaces",
    "check": "node --check scripts/dev.mjs && node --check scripts/static-site.mjs && npm run check --workspaces",
    "dev:aurora": "npm run dev --workspace=@templates/aurora"
  }
}
